{
  "name": "jobpipe-editor",
  "private": true,
  "description": "Builds jobpipe/web/static/vendor/editor.js, the impact record's WYSIWYG markdown editor (Milkdown).",
  "scripts": {
    "build": "esbuild editor.js --bundle --minify --format=iife --target=es2020 --outfile=../../jobpipe/web/static/vendor/editor.js --legal-comments=linked"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
